---

import {twMerge} from 'tailwind-merge'

interface Props {
 id: string   //a unique identifier for this component, allowing multiple dropdowns on a page without collisions
 caption?: string   //the text displayed in the trigger button
 buttonStyles?: string   //any additional Tailwind classes for customizing the trigger button
 dropdownStyles?: string   //any additional styles to apply to the dropdown container <div>
 listStyles?: string   //any additional styles to apply to the <ul>
 moveXY?: string //comma separated integer values specifying x,y shift in dropdown position
 duration?: string, //duration (in milliseconds) for dropdown height transition
 behavior?:string //specify click | hover options
}

const {
	id, 
	caption, 
	buttonStyles, 
	dropdownStyles, 
	listStyles, 
	moveXY = "0,0", 
	duration = '100ms',
	behavior = 'click'
} = Astro.props

//appearance-none removes all the default butotn styling
const tw = {
		triggerButton: 'appearance-none not-content select-none cursor-pointer inline-flex items-center rounded-md p-2 drop-shadow-2xl  ' +
		'font-semibold text-md lg:text-lg ' +
		'bg-slate-200 hover:bg-slate-300 text-zinc-700 ' + 
		'dark:text-zinc-300 dark:bg-indigo-600 dark:hover:bg-indigo-800 ' + 
		'border-2 border-slate-500 dark:border-indigo-400 ',
	dropdownContainer:'h-0 absolute z-10 ' + 
		'rounded-lg drop-shadow-2xl overflow-hidden ' + 
		'text-lg font-medium ' +
		'bg-white dark:bg-gray-800 ' ,
	itemsList:'inline-block flex flex-col text-left gap-y-4 cursor-pointer ' + 
		'py-4 font-semibold text-gray-900 dark:text-zinc-50',
}

const hs = {
	sharedToggle:`
		init
			set :menu to 'menu-' + my @id
			set :menuItems to 'menuItems-' + my @id
			set :menuHasMouse to false
		end -- init 

		def toggleDropdown
			if my @aria-expanded is 'true' then send closeDropdown to me 
			otherwise send openDropdown to me
		end -- shared open/close toggle

		on click from me
			toggleDropdown()
		end -- click toggles open/closedto

		on keydown[key=='Escape'] from document
			if my @aria-expanded is 'true' send closeDropdown to me
		end  -- escape key`,

	clickOnly:`
		on blur
			send closeDropdown to me 
		end -- close on blur`,
	clickHide:`
		on click or mouseleave send closeDropdown to the previous .trigger-button
		`,
	hoverOnly:`
		on mouseenter from me
			call me.focus() then send openDropdown to me
		end -- listener for hover

		on mouseleave from me
			call me.blur()
			wait 50ms then
				if not :menuHasMouse send closeDropdown to me
			end
		end -- close on mouseleave

		on menuHasMouse(value)
			set :menuHasMouse to value
		end -- update state of mouse location
		`,
	hoverHide: `
		on mouseenter send menuHasMouse(value:true) to the previous .trigger-button end
		on mouseleave send menuHasMouse(value:false) to the previous .trigger-button end
		on click or mouseleave send closeDropdown to the previous .trigger-button end`,
	dropdownAction:`
		def calcOpenHeight
				set menuHeight to 0 then set items to the children of the #{:menu}
				for item in items increment the menuHeight by the item's offsetHeight end
				return menuHeight
			end -- calcOpenHeight
			
			def repositionMenu
				set offsets to (my @movexy) split by ','
				set xOffset to the offsets[0] as Int
				set yOffset to the offsets[1] as Int
				measure me then put the result.bounds into buttonLocation
				set the *left of the #{:menu} to (buttonLocation.left + xOffset + window.pageXOffset) px
				set the *top of the #{:menu} to (buttonLocation.bottom  + yOffset + window.pageYOffset) px
			end  -- move menu by x,y pixels

			on openDropdown from me
				repositionMenu()
				set @aria-expanded of me to 'true'
				set @aria-hidden of the #{:menu} to 'false'
				set the *height of the #{:menu} to the calcOpenHeight() px
			end -- openDropdown

			on closeDropdown
				set @aria-expanded of me to 'false'
				set @aria-hidden of the #{:menu} to 'true'
				set the *height of the #{:menu} to 0 then settle
			end -- closeDropdown`,
}
const behaviors = {
   click: hs.sharedToggle + " " + hs.clickOnly + " " + hs.dropdownAction,
	 hover: hs.sharedToggle + " " + hs.hoverOnly + " " + hs.dropdownAction
	}
---

<div class="dropdownmenu">
	<!-- Trigger -->
	<button id={id} type='button' moveXY={moveXY}
		class={'trigger-button ' + twMerge(tw.triggerButton, buttonStyles)}
		aria-haspopup='menu'
		aria-expanded='false'
		aria-controls={`menuItems-${id}`}
		script={behavior === 'click' ? `${behaviors.click}`: `${behaviors.hover}`}>
		<slot name='leftIcon' />
		{caption}
		<slot name='rightIcon'/>
	</button>
	<!-- Dropdown -->
	<div id={`menu-${id}`}
		aria-hidden='true'
		class={twMerge(tw.dropdownContainer, dropdownStyles)}
		style=`transition: height ${duration} ease-in-out`>
			<ul id={`menuItems-${id}`}
				role='menu'
				aria-labelledby={id}
				class={twMerge(tw.itemsList, listStyles)}
				script={behavior == 'click' ? `${hs.clickHide}`:`${hs.hoverHide}`} >
				<slot/>
			</ul>
	</div>
</div>


