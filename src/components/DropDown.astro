---

import {twMerge} from 'tailwind-merge'

interface Props {
 id: string   //a unique identifier for this component, allowing multiple dropdowns on a page without collisions
 caption?: string   //the text displayed in the trigger button
 buttonStyles?: string   //any additional Tailwind classes for customizing the trigger button
 dropdownStyles?: string   //any additional styles to apply to the dropdown container <div>
 listStyles?: string   //any additional styles to apply to the <ul>
 moveXY?: string //comma separated integer values specifying x,y shift in dropdown position
 duration?: string, //duration (in milliseconds) for dropdown height transition
 behavior?:string //specify click | hover options
}

const {
	id, 
	caption, 
	buttonStyles, 
	dropdownStyles, 
	listStyles, 
	moveXY = "0,0", 
	duration = '100ms',
	behavior = 'click'
} = Astro.props

const tw = {
	triggerButton: 'inline-block rounded-lg px-4 ' +
		'font-semibold text-md lg:text-lg text-zinc-100 hover:text-zinc-400 hover:dark:text-zinc-300 ' + 
		'bg-indigo-600 hover:bg-indigo-800 ' +
		'focus:ring-4 focus:outline-none focus:ring-indigo-300',
	dropdownContainer:'h-0 absolute z-10 ' + 
		'rounded-lg drop-shadow-2xl overflow-hidden ' + 
		'text-lg font-medium ' +
		'bg-white dark:bg-gray-800 ',
	itemsList:'flex flex-col text-left gap-y-4 cursor-pointer ' + 
		'py-4 font-semibold text-gray-900 dark:text-zinc-50',
}

const hs = {
	clickToggle:`
		init
			set :menu to 'menu-' + my @id
			set :menuItems to 'menuItems-' + my @id
		end -- init 

		on click from me
			if I match .open then send closeDropdown to me 
			otherwise send openDropdown to me
		end -- click toggles open/closedto

		on keydown[key=='Escape'] or blur
			send closeDropdown to me 
		end  -- escape key`,
	clickHide:`
		on click or mouseleave send closeDropdown to the previous <button/> 
		`,
	hoverToggle:`
		init
					set :menu to 'menu-' + my @id
					set :menuItems to 'menuItems-' + my @id
					set :menuHasMouse to false
		end -- init
			
		on mouseenter from me
			call me.focus() then send openDropdown to me
		end -- listener for hover

		on mouseleave from me
			call me.blur()
			wait 50ms then
				if not :menuHasMouse send closeDropdown to me
			end
		end -- close on mouseleave

		on click from me
			if I match .open then send closeDropdown to me 
			otherwise send openDropdown to me
		end -- click handler

		on menuHasMouse(value)
			set :menuHasMouse to value
		end -- update state of mouse location

		on keydown[key=='Escape']
			send closeDropdown to me
		end  -- Escape key handler
		`,
	hoverHide: `
		on mouseenter send menuHasMouse(value:true) to the previous <button/> end
		on mouseleave send menuHasMouse(value:false) to the previous <button/> end
		on click or mouseleave send closeDropdown to the previous <button/> end`,
	dropdownAction:`
		def calcOpenHeight
				set menuHeight to 0 then set items to the children of the #{:menu}
				for item in items increment the menuHeight by the item's offsetHeight end
				return menuHeight
			end -- calcOpenHeight
			
			def repositionMenu
				set offsets to (my @movexy) split by ','
				set xOffset to the offsets[0] as Int
				set yOffset to the offsets[1] as Int
				measure me then put the result.bounds into buttonLocation
				set the *left of the #{:menu} to (buttonLocation.left + xOffset + window.pageXOffset) px
				set the *top of the #{:menu} to (buttonLocation.bottom  + yOffset + window.pageYOffset) px
			end  -- move menu by x,y pixels

			on openDropdown from me
				repositionMenu()
				set the *height of the #{:menu} to the calcOpenHeight() px then 
				add .open to me
			end -- openDropdown

			on closeDropdown
				set the *height of the #{:menu} to 0 then settle then
				remove .open from me
			end -- closeDropdown`,
}
const behaviors = {
   click: hs.clickToggle + " " + hs.dropdownAction,
	 hover: hs.hoverToggle + " " + hs.dropdownAction
	}
---

<div class="not-content">
	<!-- Trigger -->
	<button id={id} type='button' moveXY={moveXY}
		class={twMerge(tw.triggerButton, buttonStyles)}
		script={behavior === 'click' ? `${behaviors.click}`: `${behaviors.hover}`}>
		<slot name='leftIcon' />
		{caption}
		<slot name='rightIcon'/>
	</button>
	<!-- Dropdown -->
	<div id=`menu-${id}` 
		class={twMerge(tw.dropdownContainer, dropdownStyles)}
		style=`transition: height ${duration} ease-in-out`>
			<ul id=`menuItems-${id}`
				class={twMerge(tw.itemsList, listStyles)}
				script={behavior == 'click' ? `${hs.clickHide}`:`${hs.hoverHide}`} >
				<slot/>
			</ul>
	</div>
</div>


