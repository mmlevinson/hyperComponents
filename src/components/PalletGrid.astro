---
import PalletGridH from "./PalletGridH.astro"
import PalletGridV from "./PalletGridV.astro"

interface Props {
	orientation?:string //horizontal or vertical
	hs?:string //custom action when a swatch is selected
}

const {orientation = "horizontal", hs} = Astro.props
---

<div >
	{orientation === 'horizontal' ? <PalletGridH hs={hs}/> : <PalletGridV hs={hs}/>}
</div>





