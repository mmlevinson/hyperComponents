---
//values passed in via attributes on individual <TabPanel_A>s
interface Props {
	defaultTabId?:string  // the id of the tab to activate on load
	minHeight?:string // shortest vertical height of the </output>
	maxHeight?:string  // tallest vertical height of the </output>
}

const {
	defaultTabId = '0',
	minHeight = 'min-h-[30rem]',
	maxHeight = 'max-h-[30rem]'
} = Astro.props

//export styles as one-source-of-truth for TabPanel_A and TabPanelItem_A
export const tw = {
	container: 'tab-panel not-content',
	tabList: 'flex flex-wrap',
	output: 'block text-left p-4 w-full overflow-y-scroll bg-gray-100 dark:bg-gray-950 ',
	tabItem: 'z-10 tab-item not-content select-none font-semibold rounded-t-xl cursor-pointer ' +
		'hover:bg-orange-100 dark:hover:bg-purple-900 border-2 border-slate-600 ' +
		'bg-slate-300 dark:bg-gray-800 text-blue-900 dark:text-zinc-200 ' +
		'aria-selected:border-b-0 aria-selected:bg-gray-100 dark:aria-selected:bg-gray-950 ' +
		'aria-selected:text-blue-950 dark:aria-selected:text-orange-200'
}

const hs =
	`
	on init
		set :loadCount to 0
	end -- init

	on load
		if :loadCount is greater than 1 then exit end
		send activateTabById(tabId:'${defaultTabId}') to me
		increment :loadCount
	end -- load handler

	on activateTabById(tabId)
		set requestedTab to #{tabId}
		if requestedTab exists
			send activateTab(clickedTab:requestedTab) to me
		end -- if
	end -- activate tab by id

	on activateTab(clickedTab)
		take @aria-selected='true' from <[role=tab]/> in me for clickedTab
		for tab in <[role=tab]/> in me
			if tab is not clickedTab
				set tab's @aria-selected to 'false'
			end -- if
		end -- for
		take @tabindex='0' from <[role=tab]/> in me for clickedTab
		for tab in <[role=tab]/> in me
			if tab is not clickedTab
				set tab's @tabindex to '-1'
			end -- if
		end -- for
		set panel to the first <[role='tabpanel']/> in me
		if panel exists
			set panel's @aria-labelledby to clickedTab's @id
		end -- if
	end -- activate tab
	`
---

<div class={tw.container} script={hs}>
	<div class={tw.tabList} role='tablist'>
		<slot/>
	</div>
	<output id='tabpanel-output-a' role='tabpanel' aria-live='polite' class={tw.output + ' ' + maxHeight + ' ' + minHeight}/>
</div>
