---
//values passed in via attributes on individual <TabPanelItem>s
interface Props {
	id: string  // a unique identifier
	caption: string  // a string displayed in the Tab
	path: string  // the API route to be loaded when the Tab is active
	trigger?: string  // multipe triggers separated by 'or'
}

//destruct props into local constants
const { 
	id, 
	caption, 
	path,
  trigger = 'click' 
} = Astro.props

//get our styles
import {tw} from './TabPanel.astro'

//interpolate props (as constants) into our Hyperscript code
const hs = `
  on ${trigger}
		send activateTab(clickedTab:me) to the closest <.tab-panel/>
		set *opacity of the next <output/> to 0
	  fetch '${path}' as html then put the result into the next <output/>
		wait 50ms  -- prevents intermittant quick flash of content without transition
		transition the next <output/>'s *opacity to 1 over 170ms

`
---

<button id={id} class={tw.tabItem} script={hs}>
	{caption}
</button>
	 
