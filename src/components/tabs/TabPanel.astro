---
import {twMerge} from 'tailwind-merge'
 
interface Props {
	defaultTabId?:string  // The id of the tab to be activated by default	
	maxHeight?:string  // The maximum height of the panel content area
}
 
const {
	defaultTabId = '0',
	maxHeight = 'max-h-[30rem]'
} = Astro.props 
 
export const tw = {
	container: 'tab-panel not-content flex justify-left ',
	output: 'block text-left p-4 w-full overflow-y-scroll ' +
	  'bg-gray-100 dark:bg-gray-950 ',
	tabItem: 'z-10 tab-item not-content select-none ' + 
	'font-semibold rounded-t-xl cursor-pointer ' + 
	'hover:bg-orange-100 dark:hover:bg-purple-900 ' +
	'border-2  border-slate-600 ',
	activeLight: 'bg-gray-100',
	activeDark: 'dark:bg-gray-950',
	inactiveLight: 'bg-slate-300',
	inactiveDark: 'dark:bg-gray-800',
	textActiveLight: 'text-blue-950',
	textActiveDark: 'dark:text-orange-200',
	textInactiveLight: 'text-blue-900',
	textInactiveDark: 'dark:text-zinc-200'
}

const hs = 
	`
-- Curiously, logging shows multiple 'load' events, so we debounce the duplicates

-- With Tailwind, we cannot just add multiple styles for the same thing.  Tailwind sorts classes alpha with the last
-- being the winner, so for example you cannot have multiple background classes without potential abberent behavior (not knowing which will win)
-- That is why we cannot just 'take' the classes from the current active tab and and give them to the clickedTab
-- b/c all the inactive classes  remain and may win (depending on which colors you are using)
-- 'remove' can take advantage 'flat-mapping' to loop through all children in one step, but we must only add the active classes
-- to the clicked tab and the inactive classes to all other tabs.   
-- This is a Tailwind issue, not Hyperscript !!

	on init
    set :loadCount to 0
	end -- init

	on load
	  if :loadCount is greater than 1 then exit end
		send activateTabById(tabId:'${defaultTabId}') to me
		increment :loadCount
  end -- load handler

	on activateTabById(tabId)
		set requestedTab to #{tabId}
		if requestedTab exists
			send activateTab(clickedTab:requestedTab) to me
		end
	end -- activate tab by id

	on activateTab(clickedTab)
		remove .${tw.inactiveLight} .${tw.inactiveDark} .${tw.textInactiveLight} .${tw.textInactiveDark} from the <.tab-item/> in me
		remove .border-b-0 .${tw.activeLight} .${tw.activeDark} .${tw.textActiveLight} .${tw.textActiveDark} from the <.tab-item/> in me
		set allTabs to <.tab-item/> in me
		for tab in allTabs
			if tab is really clickedTab then
				add .border-b-0 .${tw.activeLight} .${tw.activeDark} .${tw.textActiveLight} .${tw.textActiveDark} to the tab
			else
				add .${tw.inactiveLight} .${tw.inactiveDark} .${tw.textInactiveLight} .${tw.textInactiveDark} to the tab
			end
		end


	end  -- activateTab handler

	`
 
---
 
<div class={tw.container}
	hx-trigger="click"
	hx-swap="innerHTML transition:true"
	hx-target="next <output/>"
	script={hs} >
  <slot/>
</div>
<output class={tw.output + ' ' + maxHeight}/>

